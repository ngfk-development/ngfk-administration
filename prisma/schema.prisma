generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Service {
  MONEYBIRD @map("moneybird")
  HARVEST   @map("harvest")
  JIRA      @map("jira")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  harvest_id                Int?    @unique
  moneybird_id              String? @unique
  moneybird_version         Int?
  moneybird_customer_number String?

  company_name String?
  address      String?
  zipcode      String?
  city         String?
  country      String?

  chamber_of_commerce_number String?
  tax_number                 String?

  created_origin Service
  created_at     DateTime @default(now())
  updated_origin Service
  updated_at     DateTime @updatedAt

  contacts Contact[]
  projects Project[]

  @@index([moneybird_id])
  @@map("customers")
}

model Contact {
  id String @id @default(uuid()) @db.Uuid

  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  customer_id String   @db.Uuid

  harvest_id        Int?    @unique
  moneybird_id      String? @unique
  moneybird_version Int?

  first_name String?
  last_name  String?
  phone      String?
  email      String?
  title      String?

  created_origin Service
  created_at     DateTime @default(now())
  updated_origin Service
  updated_at     DateTime @updatedAt

  @@index([moneybird_id])
  @@map("contacts")
}

model Project {
  id String @id @default(uuid()) @db.Uuid

  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  customer_id String   @db.Uuid

  harvest_id   Int?    @unique
  moneybird_id String? @unique

  name        String
  code        String?
  active      Boolean
  billable    Boolean
  hourly_rate Int

  created_origin Service
  created_at     DateTime @default(now())
  updated_origin Service
  updated_at     DateTime @updatedAt

  @@index([updated_at])
  @@map("projects")
}
