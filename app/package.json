{
  "name": "@app/directus",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-bundle"
  ],
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "clean": "rimraf dist",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/api": "^11.0.1",
    "@directus/extensions-sdk": "^10.1.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.3"
  },
  "icon": "extension",
  "directus:extension": {
    "host": "^10.1.3",
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "ngfk-hook",
        "source": "src/hooks/hook.ts"
      },
      {
        "type": "endpoint",
        "name": "ngfk-endpoint",
        "source": "src/endpoints/endpoint.ts"
      }
    ]
  }
}
