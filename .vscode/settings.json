{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.ruby-lsp": true,

    "node_modules": true,

    ".gitignore": true,
    ".prettierignore": true
  },
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "prettier.prettierPath": "node_modules/prettier/index.cjs",
  "typescript.preferences.importModuleSpecifier": "non-relative"
}
